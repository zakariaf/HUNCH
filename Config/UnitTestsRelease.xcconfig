// Config/UnitTestsRelease.xcconfig — HunchTests, Release configuration.
#include "Release.xcconfig"

TEST_HOST = $(BUILT_PRODUCTS_DIR)/Hunch.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Hunch
BUNDLE_LOADER = $(TEST_HOST)

// A test bundle needs its own identifier; Base sets the app%s.
PRODUCT_BUNDLE_IDENTIFIER = $(HUNCH_BUNDLE_ID_PREFIX).hunchtests
