// Config/UnitTests.xcconfig — the HunchTests bundle only.
// Hosted by the app so Bundle.main is the app bundle and BuildSettingsTests can read the
// GENERATED Info.plist (01 P30). A unit-test bundle must NOT set USES_XCTRUNNER.
#include "Debug.xcconfig"

TEST_HOST = $(BUILT_PRODUCTS_DIR)/Hunch.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Hunch
BUNDLE_LOADER = $(TEST_HOST)

// A test bundle needs its own identifier; Base sets the app%s.
PRODUCT_BUNDLE_IDENTIFIER = $(HUNCH_BUNDLE_ID_PREFIX).hunchtests
