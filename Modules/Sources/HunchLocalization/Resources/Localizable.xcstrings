      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your counts return to zero. Your Codex, ladder and Profile are untouched."
          }
        }
      }
    },
    "ALERT_CLEAR_STATISTICS_VERB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      },
      "comment": "Destructive button in the clear-statistics alert."
    },
    "ALERT_CLEAR_CODEX_TITLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the Codex?"
          }
        }
      }
    },
    "ALERT_CLEAR_CODEX_BODY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every page is deleted. ECHO and SIEVE lock again. The toolbox you have earned stays."
          }
        }
      }
    },
    "ALERT_CLEAR_CODEX_VERB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      },
      "comment": "Destructive button in the clear-Codex alert. A different object is being cleared."
    },
    "ALERT_RESET_PROFILE_TITLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the Profile?"
