    "A11Y_GLYPH_LABEL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, %3$@, %4$@"
          }
        }
      },
      "comment": "Spoken glyph label. Four interpolations in canonical order: fill, shape, pips, hue. Never concatenate fragments — the adjective order differs by language."
    },
