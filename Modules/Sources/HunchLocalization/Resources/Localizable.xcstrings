        }
      }
    },
    "ALERT_RESET_PROFILE_BODY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The portrait re-forms from nothing. Your pages and your ladder stay."
